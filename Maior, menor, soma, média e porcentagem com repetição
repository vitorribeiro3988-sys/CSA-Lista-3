using System;

class Program
{
    static void Main()
    {
        string continuar;

        do
        {
            Console.Write("Digite a quantidade de números (N): ");
            int n = int.Parse(Console.ReadLine());

            while (n <= 0 || n >= 20)
            {
                Console.WriteLine("Erro: O valor de N deve ser positivo e menor que 20!");
                Console.Write("Digite a quantidade de números (N) novamente: ");
                n = int.Parse(Console.ReadLine());
            }

            int[] valores = new int[n];
            int soma = 0;
            int maior = 0;
            int menor = 0;
            int contPositivos = 0;
            int contNegativos = 0;

            for (int i = 0; i < n; i++)
            {
                Console.Write($"Digite o {i + 1}º valor: ");
                valores[i] = int.Parse(Console.ReadLine());

                soma += valores[i];

                if (i == 0)
                {
                    maior = valores[i];
                    menor = valores[i];
                }
                else
                {
                    if (valores[i] > maior)
                    {
                        maior = valores[i];
                    }
                    if (valores[i] < menor)
                    {
                        menor = valores[i];
                    }
                }

                if (valores[i] > 0)
                {
                    contPositivos++;
                }
                else if (valores[i] < 0)
                {
                    contNegativos++;
                }
            }

            double media = (double)soma / n;
            double pctPositivos = ((double)contPositivos / n) * 100;
            double pctNegativos = ((double)contNegativos / n) * 100;

            Console.WriteLine();
            Console.WriteLine($"Maior valor: {maior}");
            Console.WriteLine($"Menor valor: {menor}");
            Console.WriteLine($"Soma dos valores: {soma}");
            Console.WriteLine($"Média aritmética: {media}");
            Console.WriteLine($"Porcentagem de valores positivos: {pctPositivos}%");
            Console.WriteLine($"Porcentagem de valores negativos: {pctNegativos}%");
            Console.WriteLine();

            Console.Write("Deseja uma nova execução do programa? (S/N): ");
            continuar = Console.ReadLine().ToUpper();

            while (continuar != "S" && continuar != "N")
            {
                Console.WriteLine("Erro: Resposta inválida! Digite apenas 'S' ou 'N'.");
                Console.Write("Deseja uma nova execução do programa? (S/N): ");
                continuar = Console.ReadLine().ToUpper();
            }

        } while (continuar == "S");
    }
}
