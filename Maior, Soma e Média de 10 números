using System;

class Program
{
    static void Main()
    {
        int[] valores = new int[10];
        int soma = 0;
        int maior = 0;

        for (int i = 0; i < 10; i++)
        {
            Console.Write($"Digite o {i + 1}º valor positivo: ");
            int numero = int.Parse(Console.ReadLine());

            while (numero <= 0)
            {
                Console.WriteLine("Erro: O valor deve ser positivo");
                Console.Write($"Digite o {i + 1}º valor positivo novamente: ");
                numero = int.Parse(Console.ReadLine());
            }

            valores[i] = numero;
            soma += numero;

            if (i == 0 || numero > maior)
            {
                maior = numero;
            }
        }

        double media = (double)soma / 10;

        Console.WriteLine($"\nMaior valor: {maior}");
        Console.WriteLine($"Soma dos valores: {soma}");
        Console.WriteLine($"Média: {media}");
    }
}
